{
  "expo": {
    "name": "CapturaGo",
    "slug": "capturago",
    "scheme": "capturago",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF3E7",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.capturago.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.capturago.app",
      "adaptiveIcon": {
        "backgroundColor": "#211911",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#FAF3E7"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CapturaGo uses your photos only when you choose them: a cover or portfolio photos for your listing, or finished photos to deliver to your client.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
